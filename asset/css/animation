/* =========================
ANIMATION
========================= */

.fade-up{
opacity:0;
transform:translateY(40px);
transition:all 1s ease;
}

.fade-up.show{
opacity:1;
transform:translateY(0);
}

.zoom-in{
opacity:0;
transform:scale(.9);
transition:all 1s ease;
}

.zoom-in.show{
opacity:1;
transform:scale(1);
}

.slide-left{
opacity:0;
transform:translateX(-60px);
transition:all 1s ease;
}

.slide-left.show{
opacity:1;
transform:translateX(0);
}

.slide-right{
opacity:0;
transform:translateX(60px);
transition:all 1s ease;
}

.slide-right.show{
opacity:1;
transform:translateX(0);
}

/* Hover Premium */

.hover-up{
transition:.4s;
}

.hover-up:hover{
transform:translateY(-8px);
}
```
